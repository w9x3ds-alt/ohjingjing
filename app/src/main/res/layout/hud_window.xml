<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗：只有人物形象 + 一块半透明黑底余额牌。
  Token 折算、今日消耗、状态文字已全部移除。
  顶部留 46dp 给气泡 / 掉额提示浮层。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="150dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="46dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/hud_img"
            android:layout_width="134dp"
            android:layout_height="141dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/whale_char" />

        <TextView
            android:id="@+id/hud_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:background="@drawable/hud_plate"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:includeFontPadding="false"
            android:text="@string/hud_balance_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- 点击时冒出来的随机气泡 -->
    <TextView
        android:id="@+id/hud_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:maxWidth="210dp"
        android:background="@drawable/bubble_bg"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#22315C"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 掉余额时头顶弹出的 -xx -->
    <TextView
        android:id="@+id/hud_delta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/delta_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:includeFontPadding="false"
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
